{
  "name": "parcelflow-playwright-tests",
  "version": "1.0.0",
  "private": true,
  "description": "UI, REST, gRPC and database test automation with Playwright and TypeScript for a shipment tracking app",
  "type": "module",
  "scripts": {
    "app": "node demo-app/server.js",
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:grpc": "playwright test --project=grpc",
    "test:db": "playwright test --project=db",
    "test:ui": "playwright test --project=chromium --project=mobile",
    "test:smoke": "playwright test --grep @smoke",
    "report": "playwright show-report",
    "allure:serve": "allure serve allure-results",
    "proto": "buf lint && buf generate",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@bufbuild/buf": "^1.75.0",
    "@bufbuild/protobuf": "^2.16.0",
    "@eslint/js": "^9.39.5",
    "@faker-js/faker": "^10.6.0",
    "@grpc/grpc-js": "^1.14.7",
    "@grpc/proto-loader": "^0.8.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.14.0",
    "eslint": "^9.39.5",
    "eslint-plugin-playwright": "^2.12.1",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "ts-proto": "^2.18.4",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.72.1",
    "zod": "^4.6.7"
  }
}
