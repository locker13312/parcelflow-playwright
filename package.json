{
  "name": "parcelflow-playwright-tests",
  "version": "1.0.0",
  "private": true,
  "description": "UI and API test automation framework with Playwright and TypeScript for a shipment tracking app",
  "type": "module",
  "scripts": {
    "app": "node demo-app/server.js",
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=chromium --project=mobile",
    "test:smoke": "playwright test --grep @smoke",
    "report": "playwright show-report",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-plugin-playwright": "^2.12.1",
    "prettier": "^3.9.10",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.72.1",
    "zod": "^4.6.7"
  }
}
